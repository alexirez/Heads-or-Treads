{
  "name": "heads-or-treads",
  "version": "0.1.0",
  "private": true,
  "description": "Simultaneous-turn 3D isometric tank duel where every move is a gamble. Peer-to-peer WebRTC, deterministic lockstep, TypeScript, Three.js, htmx, Angular.",
  "keywords": [
    "typescript",
    "threejs",
    "htmx",
    "angular",
    "webrtc",
    "peer-to-peer",
    "turn-based",
    "isometric",
    "game"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @hot/server dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
